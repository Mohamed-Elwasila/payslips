[Unit]
Description=Fetch Deliveroo invoices and save them to the database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/path/to/payslips
Environment=PATH=/path/to/payslips/venv/bin:/usr/bin:/bin
ExecStart=/path/to/payslips/venv/bin/python -m src.main fetch

[Install]
WantedBy=multi-user.target
